# MongoDB connection string for Next.js + Mongoose backend
# Copy this file to .env.local and fill in your credentials before running `npm run dev`.
MONGODB_URI=mongodb://127.0.0.1:27017/field-notes-blog

# Secret used to sign and verify JWT session tokens in /api/auth/* and /api/posts/*
JWT_SECRET=replace-with-a-random-32-byte-secret-string
